{
  "name": "epf-google-ads-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "node --check src/server.js && node --check src/worker.js && node --check scripts/get-refresh-token.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:dry-run": "wrangler deploy --dry-run",
    "start": "node src/server.js",
    "token": "node scripts/get-refresh-token.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "dotenv": "^16.4.7",
    "google-ads-api": "^23.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "wrangler": "^4.53.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
